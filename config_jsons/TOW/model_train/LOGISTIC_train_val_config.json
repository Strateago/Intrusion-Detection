{
    "feat_gen": {
        "feature_generator": "CNNIDSFeatureGenerator",
        "config": {
            "window_size": 44,
            "window_slide": 1,
            "number_of_bytes": 58,
            "multiclass": false,
            "labeling_schema": "TOW_IDS_dataset_one_class",
            "dataset": "TOW_IDS_dataset",
            "sum_x": true
        },
        "load_paths": {
            "X_path": "feature_extracted/TOW/detection/train/X_train_TOW_IDS_dataset_one_class_Wsize_44_Cols_116_Wslide_1_MC_False_sumX_True.npz",
            "y_path": "feature_extracted/TOW/detection/train/y_train_TOW_IDS_dataset_one_class_Wsize_44_Cols_116_Wslide_1_MC_False_sumX_True.csv"
        }
    },
    "model_specs": {
        "framework": "sklearn",
        "model": "SklearnClassifier",
        "model_name": "LogisticRegression",
        "model_params": {
            "C": 1.0,
            "penalty": "l2",
            "solver": "lbfgs",
            "max_iter": 1000,
            "random_state": 42
        },
        "hyperparams_grid": {
            "clf__C": [0.01, 0.1, 1.0, 10],
            "clf__penalty": ["l2"],
            "clf__solver": ["lbfgs", "saga"],
            "clf__max_iter": [500, 1000],
            "clf__random_state": [42]
        },
        "paths": {
            "metrics_output_path": "output/TOW/LR/metrics",
            "models_output_path": "output/TOW/LR/models"
        }
    }
}
